# Backend de dados: supabase ou nhost
EXPO_PUBLIC_DATABASE_PROVIDER=supabase

# Supabase (necessário quando EXPO_PUBLIC_DATABASE_PROVIDER=supabase)
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel

# Nhost (necessário quando EXPO_PUBLIC_DATABASE_PROVIDER=nhost)
EXPO_PUBLIC_NHOST_SUBDOMAIN=seu-subdominio
EXPO_PUBLIC_NHOST_REGION=sa-east-1

# Opcional: connection string para scripts locais de migration/diagnóstico.
# Nunca renomeie para EXPO_PUBLIC_* nem use no bundle do app.
EXPO_CS_NHOST=postgres://postgres:senha@seu-host:5432/seu-banco?sslmode=require
