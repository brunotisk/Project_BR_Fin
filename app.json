{
  "expo": {
    "name": "Plenna",
    "slug": "app-financeiro",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "appfinanceiro",
    "icon": "./assets/plenna/icon-512.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.appfinanceiro.app"
    },
    "web": {
      "bundler": "metro",
      "name": "Plenna",
      "shortName": "Plenna",
      "favicon": "./public/favicon.png",
      "splash": {
        "image": "./assets/plenna/splash-screen.png",
        "resizeMode": "contain",
        "backgroundColor": "#F5F3EA"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/plenna/icon-192.png",
          "imageWidth": 100,
          "backgroundColor": "#F5F3EA"
        }
      ]
    ]
  }
}
